# Site block for tradenot.es for the Caddy that serves ports 80/443 on the server (in a container,
# on the Docker network "edge"). Add it to that Caddy's configuration, then reload Caddy.
# No "log" directive on purpose: the privacy policy says there are no access logs.

www.tradenot.es {
	redir https://tradenot.es{uri} permanent
}

tradenot.es {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# the app on the shared Docker network "edge" (alias set in compose.hosted.yaml)
	reverse_proxy tradenotes-app:3000
}
