# Site block for tradenot.es for the Caddy that already serves ports 80/443 on the VPS (the REDACTED
# one, in a container). It imports /opt/REDACTED-data/sites/*.caddy, so this file is copied to
# /opt/REDACTED-data/sites/tradenotes.caddy, then: cd /opt/REDACTED/infra/stack && docker compose restart caddy
# No "log" directive on purpose: the privacy policy says there are no access logs.

www.tradenot.es {
	redir https://tradenot.es{uri} permanent
}

tradenot.es {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# the app on the shared Docker network "edge" (alias set in compose.hosted.yaml)
	reverse_proxy tradenotes-app:3000
}
