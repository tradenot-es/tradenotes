# Settings of the official tradenot.es (server-deploy.sh copies this to /opt/tradenotes/.env on the
# first run; never commit the real .env). Self-hosting needs none of this: see compose.yaml and
# docs/self-hosting.md.

# docker compose in /opt/tradenotes uses the hosted stack, not the self-hosting example
COMPOSE_FILE=compose.hosted.yaml

# Public URL of the app
BASE_URL=https://tradenot.es
# Session signing key: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Database password: openssl rand -hex 24
POSTGRES_PASSWORD=

# Outgoing mail (confirmation, password reset, contact form, mail to all users).
# Hostinger Business Email: SMTP login is the mailbox; the sender must be the mailbox or an
# alias of it (e.g. alias noreply@ on info@). Limit 1000 mails per 24 h and mailbox.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@tradenot.es
SMTP_PASS=
MAIL_FROM=TradeNot.es <noreply@tradenot.es>
# Recipient of the contact form and of in-app feedback
CONTACT_TO=info@tradenot.es


# Calendar: Fed speeches and the US President's schedule are fetched hourly from public calendars.
# Set to "off" to disable (e.g. for a server without internet access).
# MARKET_EVENTS=off

# In-app feedback ("Got an idea?") is always mailed to CONTACT_TO. Optionally it also becomes a
# GitHub issue: fine-grained token with "Issues: read and write" on this one repository only.
GITHUB_FEEDBACK_REPO=tradenot-es/tradenotes
GITHUB_FEEDBACK_TOKEN=

# Admin dashboard (/dashboard/admin): comma-separated e-mail addresses (own account, not the
# public info@ address); in production the
# account also needs two-factor login turned on.
ADMIN_EMAILS=admin@tradenot.es
# Mail to all users: at most this many per 24 hours (Hostinger Business Starter: 1000/day)
MAIL_DAILY_LIMIT=800
